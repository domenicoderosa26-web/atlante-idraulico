  "inference_rules": [
    {
      "topics": [
        "pai-idraulico"
      ],
      "all": [
        {
          "fields": [
            "title",
            "ref"
          ],
          "pattern": "\\bpai\\b|piano stralcio.*assetto idrogeologico"
        },
        {
          "fields": [
            "title",
            "ref"
          ],
          "pattern": "idraulic|esondazion|fasce fluviali"
        }
      ]
    },
    {
      "topics": [
        "pai-frane"
      ],
      "all": [
        {
          "fields": [
            "title",
            "ref"
          ],
          "pattern": "\\bpai\\b|piano stralcio.*assetto idrogeologico"
        },
        {
          "fields": [
            "title",
            "ref"
          ],
          "pattern": "fran[ae]|franosi"
        }
      ]
    },
    {
      "topics": [
        "pai-frane"
      ],
      "all": [
        {
          "fields": [
            "title",
            "ref"
          ],
          "pattern": "\\bpai\\b"
        },
        {
          "fields": [
            "summary"
          ],
          "pattern": "pai frane|pai.*rischio da frana"
        }
      ]
    },
    {
      "topics": [
        "pai-geomorfologico"
      ],
      "all": [
        {
          "fields": [
            "title",
            "ref"
          ],
          "pattern": "\\bpai\\b|piano stralcio.*assetto idrogeologico"
        },
        {
          "fields": [
            "title",
            "ref"
          ],
          "pattern": "geomorfologic"
        }
      ]
    },
    {
      "topics": [
        "pgra"
      ],
      "all": [
        {
          "fields": [
            "title",
            "ref"
          ],
          "pattern": "\\bpgra\\b|piano di gestione del rischio (?:di )?alluvion"
        }
      ]
    },
    {
      "topics": [
        "pzp"
      ],
      "all": [
        {
          "fields": [
            "title",
            "ref"
          ],
          "pattern": "\\bpzp\\b|piano delle zone di pericolo"
        }
      ]
    },
    {
      "topics": [
        "pzp"
      ],
      "all": [
        {
          "fields": [
            "title"
          ],
          "pattern": "interventi nelle zone di pericolo"
        },
        {
          "fields": [
            "ref"
          ],
          "pattern": "23/2019"
        },
        {
          "fields": [
            "regions"
          ],
          "pattern": "trentino-alto adige"
        }
      ]
    },
    {
      "topics": [
        "dissesto"
      ],
      "all": [
        {
          "fields": [
            "title",
            "summary"
          ],
          "pattern": "fran[ae]|stabilita dei versanti"
        }
      ],
      "unless_topics": [
        "pai-frane",
        "pai-geomorfologico"
      ]
    }
  ],
